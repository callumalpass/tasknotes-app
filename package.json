{
  "name": "tasknotes-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.7.0",
  "scripts": {
    "manifest": "node scripts/write-manifest.mjs",
    "manifest:dev": "node scripts/write-manifest.mjs --development",
    "dev": "pnpm manifest:dev && vite",
    "build": "pnpm manifest && tsc -b && vite build && node scripts/write-static-routes.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:cloud": "pnpm --dir ../mdbase-connect build && node scripts/cloud-e2e.mjs",
    "test:production-smoke": "node scripts/production-smoke.mjs",
    "test:android-smoke": "node scripts/android-smoke.mjs",
    "test:android-folder-smoke": "node scripts/android-smoke.mjs --folder",
    "test:conformance:tasknotes": "node scripts/run-tasknotes-conformance.mjs",
    "test:conformance:mdbase": "node scripts/verify-mdbase-collection.mjs",
    "test:conformance": "pnpm test:conformance:tasknotes && pnpm test:conformance:mdbase",
    "fixture:benchmark": "node scripts/generate-benchmark-vault.mjs",
    "benchmark:index": "node scripts/benchmark-local-index.mjs",
    "verify": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test && pnpm test:conformance && pnpm build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cap:sync": "pnpm build && cap sync",
    "android": "pnpm cap:sync && cap run android"
  },
  "dependencies": {
    "@capacitor-firebase/messaging": "8.3.0",
    "@capacitor/app": "8.1.1",
    "@capacitor/browser": "8.0.2",
    "@capacitor/core": "8.4.2",
    "@capacitor/filesystem": "8.1.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/push-notifications": "8.0.2",
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@fontsource/azeret-mono": "5.3.0",
    "@fullcalendar/core": "6.1.17",
    "@fullcalendar/daygrid": "6.1.17",
    "@fullcalendar/interaction": "6.1.17",
    "@fullcalendar/list": "6.1.17",
    "@fullcalendar/react": "6.1.17",
    "@fullcalendar/timegrid": "6.1.17",
    "@mdbase/connect": "file:vendor/mdbase-connect-0.1.0-beta.7-c4fd2f801b12.tgz",
    "@mdbase/connect-protocol": "file:vendor/mdbase-connect-protocol-0.1.0-beta.7-c4fd2f801b12.tgz",
    "@mdbase/connect-sync": "file:vendor/mdbase-connect-sync-0.1.0-beta.7-c4fd2f801b12.tgz",
    "@tasknotes/model": "file:vendor/tasknotes-model-0.3.0-rc.3.tgz",
    "dexie": "4.4.4",
    "firebase": "12.16.0",
    "lucide-react": "1.25.0",
    "obsidian-bases-expression": "file:vendor/obsidian-bases-expression-0.3.0-rc.1.tgz",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tasknotes-nlp-core": "0.1.5",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@callumalpass/mdbase": "file:vendor/callumalpass-mdbase-0.3.0-rc.1.tgz",
    "@capacitor/android": "8.4.2",
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.4.2",
    "@capacitor/ios": "8.4.2",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "fake-indexeddb": "6.2.5",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "tasknotes-spec": "file:vendor/tasknotes-spec-0.2.0.tgz",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "overrides": {
      "@mdbase/connect-protocol": "file:vendor/mdbase-connect-protocol-0.1.0-beta.7-c4fd2f801b12.tgz"
    }
  }
}
