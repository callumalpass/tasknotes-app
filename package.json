{
  "name": "tasknotes-app",
  "version": "1.0.10",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.7.0",
  "scripts": {
    "i18n:extract": "mdbase-i18n extract",
    "i18n:compile": "mdbase-i18n compile",
    "i18n:check": "mdbase-i18n check --compose 'node_modules/@mdbase-dev/ui/dist/locales/{locale}/messages.json'",
    "i18n:source": "mdbase-i18n source",
    "contracts:sync": "node scripts/sync-canonical-task-pack.mjs",
    "manifest": "node scripts/write-manifest.mjs",
    "manifest:dev": "node scripts/write-manifest.mjs --development",
    "manifest:validate": "node scripts/validate-manifest.mjs public/.well-known/mdbase-app.json",
    "manifest:validate:local": "node scripts/validate-manifest.mjs public/.well-known/mdbase-app.json --allow-local",
    "dev": "pnpm manifest:dev && vite",
    "dev:e2e": "pnpm manifest:dev && vite --mode e2e",
    "deploy:dev": "node scripts/deploy-pages-dev.mjs",
    "build": "node scripts/build-production.mjs",
    "build:assets": "pnpm i18n:check && pnpm manifest && pnpm manifest:validate && tsc -b && vite build && node scripts/write-static-routes.mjs && node scripts/assert-no-production-fixtures.mjs",
    "build:e2e": "pnpm i18n:check && pnpm manifest && pnpm manifest:validate:local && tsc -b && vite build --mode e2e && node scripts/write-static-routes.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:release": "node --test scripts/*.node-test.mjs",
    "test:release:production": "node --test scripts/production-sdk.node-test.mjs scripts/native-publish-http.node-test.mjs scripts/native-publisher-upload.node-test.mjs scripts/native-publisher.node-test.mjs scripts/private-account-sdk.node-test.mjs",
    "test:native-publisher": "node --test scripts/native-publish*.node-test.mjs",
    "test:staging-intake": "node scripts/qualify-native-staging.mjs check",
    "test:staging-retained-output": "node scripts/verify-retained-staging-output.mjs",
    "test:staging-consumer": "node scripts/qualify-native-staging.mjs test",
    "build:staging:qualification": "node scripts/qualify-native-staging.mjs build",
    "test:coverage": "vitest run --coverage",
    "test:coverage:application": "vitest run src/application src/domain/default-view-source.test.ts --coverage --coverage.include='src/application/**/*.ts' --coverage.reporter=text-summary --coverage.thresholds.statements=78 --coverage.thresholds.branches=67 --coverage.thresholds.functions=77 --coverage.thresholds.lines=82",
    "test:coverage:domain": "vitest run src/domain --coverage --coverage.include='src/domain/**/*.ts' --coverage.reporter=text-summary --coverage.thresholds.statements=80 --coverage.thresholds.branches=70 --coverage.thresholds.functions=82 --coverage.thresholds.lines=84",
    "test:coverage:layers": "pnpm test:coverage:application && pnpm test:coverage:domain",
    "test:watch": "vitest",
    "bench:collections": "tsc -p benchmarks/tsconfig.json && vitest run --config benchmarks/vitest.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:connect": "playwright test --config playwright.dogfood.config.ts",
    "test:android-smoke": "node scripts/android-smoke.mjs",
    "test:production-smoke": "node scripts/production-smoke.mjs",
    "test:conformance:tasknotes": "node scripts/run-tasknotes-conformance.mjs",
    "test:conformance:mdbase": "node scripts/verify-mdbase-collection.mjs",
    "test:conformance": "pnpm test:conformance:tasknotes && pnpm test:conformance:mdbase",
    "verify": "pnpm i18n:check && pnpm test:release && pnpm format:check && pnpm typecheck && pnpm lint && pnpm test:coverage && pnpm test:coverage:layers && pnpm test:conformance && pnpm build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cap:sync": "pnpm build && cap sync",
    "android": "pnpm cap:sync && cap run android"
  },
  "dependencies": {
    "@capacitor-firebase/messaging": "8.3.0",
    "@capacitor/app": "8.1.1",
    "@capacitor/browser": "8.0.2",
    "@capacitor/core": "8.4.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/push-notifications": "8.0.2",
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@fontsource/azeret-mono": "5.3.0",
    "@lezer/highlight": "^1.2.3",
    "@lingui/core": "6.9.0",
    "@lingui/react": "6.9.0",
    "@mdbase-dev/connect": "file:vendor/connect-beta125-legacy-query-2a89e9ef.tgz",
    "@mdbase-dev/connect-protocol": "file:vendor/mdbase-dev-connect-protocol-0.1.0-beta.129-c280cd194ffd.tgz",
    "@mdbase-dev/i18n": "file:vendor/mdbase-dev-i18n-0.1.0-beta.141-24e9f5d0.tgz",
    "@mdbase-dev/obsidian-runtime": "file:vendor/mdbase-dev-obsidian-runtime-app-storage-0.0.0-07ae574c-991106d7.tgz",
    "@mdbase-dev/sdk": "file:vendor/sdk-eaa4e697-production-beta141.tgz",
    "@mdbase-dev/ui": "file:vendor/mdbase-dev-ui-0.1.0-beta.141-24e9f5d0.tgz",
    "@sqlite.org/sqlite-wasm": "3.53.4-build2",
    "@tanstack/react-virtual": "3.14.11",
    "@tasknotes/calendar": "0.1.4",
    "@tasknotes/model": "0.3.0-rc.20",
    "codemirror": "^6.0.2",
    "dexie": "4.4.4",
    "firebase": "12.16.0",
    "lucide-react": "1.25.0",
    "mdbase": "file:vendor/mdbase-browser-0.5.0-rc.1-84dbb8b7f.tgz",
    "obsidian-bases-expression": "0.3.0-rc.1",
    "picomatch": "4.0.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tasknotes-nlp-core": "file:vendor/tasknotes-nlp-core-0.2.0-72e6cab.tgz",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@callumalpass/mdbase": "0.3.0-rc.8",
    "@capacitor/android": "8.4.2",
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.4.2",
    "@capacitor/ios": "8.4.2",
    "@eslint/js": "10.0.1",
    "@lingui/cli": "6.9.0",
    "@lingui/format-po": "6.9.0",
    "@lingui/message-utils": "6.9.0",
    "@lingui/vite-plugin": "6.9.0",
    "@mdbase-dev/connect-dev": "0.1.0-beta.125",
    "@mdbase-dev/connect-testing": "0.1.0-beta.125",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.1",
    "@types/picomatch": "4.0.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "fake-indexeddb": "6.2.5",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "tasknotes-spec": "file:vendor/tasknotes-spec-0.3.0-rc.5.tgz",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "overrides": {
      "@mdbase-dev/connect": "file:vendor/connect-beta125-legacy-query-2a89e9ef.tgz",
      "@mdbase-dev/connect-sync": "0.1.0-beta.125"
    }
  }
}
