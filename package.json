{
  "name": "tasknotes-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.7.0",
  "scripts": {
    "manifest": "node scripts/write-manifest.mjs",
    "manifest:dev": "node scripts/write-manifest.mjs --development",
    "manifest:validate": "mdbase-connect-dev validate-manifest public/.well-known/mdbase-app.json",
    "dev": "pnpm manifest:dev && vite",
    "dev:e2e": "pnpm manifest:dev && vite --mode e2e",
    "build": "pnpm manifest && pnpm manifest:validate && tsc -b && vite build && node scripts/write-static-routes.mjs",
    "build:e2e": "pnpm manifest && pnpm manifest:validate && tsc -b && vite build --mode e2e && node scripts/write-static-routes.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:application": "vitest run src/application src/domain/default-view-source.test.ts --coverage --coverage.include='src/application/**/*.ts' --coverage.reporter=text-summary --coverage.thresholds.statements=78 --coverage.thresholds.branches=67 --coverage.thresholds.functions=77 --coverage.thresholds.lines=82",
    "test:coverage:domain": "vitest run src/domain --coverage --coverage.include='src/domain/**/*.ts' --coverage.reporter=text-summary --coverage.thresholds.statements=80 --coverage.thresholds.branches=70 --coverage.thresholds.functions=82 --coverage.thresholds.lines=84",
    "test:coverage:layers": "pnpm test:coverage:application && pnpm test:coverage:domain",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:cloud": "node scripts/cloud-e2e.mjs",
    "test:production-smoke": "node scripts/production-smoke.mjs",
    "test:android-smoke": "node scripts/android-smoke.mjs",
    "test:android-folder-smoke": "node scripts/android-smoke.mjs --folder",
    "test:conformance:tasknotes": "node scripts/run-tasknotes-conformance.mjs",
    "test:conformance:mdbase": "node scripts/verify-mdbase-collection.mjs",
    "test:conformance": "pnpm test:conformance:tasknotes && pnpm test:conformance:mdbase",
    "fixture:benchmark": "node scripts/generate-benchmark-vault.mjs",
    "benchmark:index": "node scripts/benchmark-local-index.mjs",
    "verify": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test:coverage && pnpm test:coverage:layers && pnpm test:conformance && pnpm build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cap:sync": "pnpm build && cap sync",
    "android": "pnpm cap:sync && cap run android"
  },
  "dependencies": {
    "@capacitor-firebase/messaging": "8.3.0",
    "@capacitor/app": "8.1.1",
    "@capacitor/browser": "8.0.2",
    "@capacitor/core": "8.4.2",
    "@capacitor/filesystem": "8.1.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/push-notifications": "8.0.2",
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@fontsource/azeret-mono": "5.3.0",
    "@fullcalendar/core": "6.1.17",
    "@fullcalendar/daygrid": "6.1.17",
    "@fullcalendar/interaction": "6.1.17",
    "@fullcalendar/list": "6.1.17",
    "@fullcalendar/react": "6.1.17",
    "@fullcalendar/timegrid": "6.1.17",
    "@mdbase-dev/connect": "file:vendor/mdbase-dev-connect-0.1.0-beta.29-7a0fca203f59.tgz",
    "@mdbase-dev/connect-protocol": "file:vendor/mdbase-dev-connect-protocol-0.1.0-beta.29-7a0fca203f59.tgz",
    "@mdbase-dev/connect-sync": "file:vendor/mdbase-dev-connect-sync-0.1.0-beta.29-7a0fca203f59.tgz",
    "@tasknotes/model": "file:vendor/tasknotes-model-0.3.0-rc.9.tgz",
    "dexie": "4.4.4",
    "firebase": "12.16.0",
    "lucide-react": "1.25.0",
    "obsidian-bases-expression": "0.3.0-rc.1",
    "picomatch": "4.0.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tasknotes-nlp-core": "0.1.5",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@callumalpass/mdbase": "file:vendor/callumalpass-mdbase-0.3.0-rc.4-4f28ea27a15a.tgz",
    "@mdbase-dev/connect-dev": "file:vendor/mdbase-dev-connect-dev-0.1.0-beta.29-7a0fca203f59.tgz",
    "@mdbase-dev/connect-testing": "file:vendor/mdbase-dev-connect-testing-0.1.0-beta.29-7a0fca203f59.tgz",
    "@capacitor/android": "8.4.2",
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.4.2",
    "@capacitor/ios": "8.4.2",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/picomatch": "4.0.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "fake-indexeddb": "6.2.5",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "tasknotes-spec": "file:vendor/tasknotes-spec-0.3.0-rc.3.tgz",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "overrides": {
      "@mdbase-dev/connect-protocol": "file:vendor/mdbase-dev-connect-protocol-0.1.0-beta.29-7a0fca203f59.tgz",
      "@mdbase-dev/connect": "file:vendor/mdbase-dev-connect-0.1.0-beta.29-7a0fca203f59.tgz",
      "@mdbase-dev/connect-sync": "file:vendor/mdbase-dev-connect-sync-0.1.0-beta.29-7a0fca203f59.tgz"
    }
  }
}
