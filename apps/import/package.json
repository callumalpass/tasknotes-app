{
  "name": "tasknotes-import",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./plan": "./src/plan.ts",
    "./todoist": "./src/todoist.ts",
    "./authorization": "./src/authorization.ts",
    "./task-repository": "./src/task-repository.ts",
    "./storage/task-repository": "./src/storage/task-repository.ts"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/metadata.mjs && vite --host 127.0.0.1",
    "build": "node scripts/metadata.mjs && tsc --noEmit && vite build && node scripts/routes.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "check": "node ../../scripts/check-import-workspace.mjs && node scripts/metadata.mjs && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@cfworker/json-schema": "4.1.1",
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@fontsource/azeret-mono": "5.3.0",
    "@mdbase-dev/sdk": "catalog:",
    "@tasknotes/model": "catalog:",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yaml": "2.9.1",
    "zod": "3.24.4"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "22.15.30",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.0",
    "wrangler": "4.131.1"
  }
}
