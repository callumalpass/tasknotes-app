# Isolated LAB-only build. Copy with explicit local harness configuration.
VITE_TASKNOTES_ENVIRONMENT=lab
VITE_TASKNOTES_LAB_ORIGIN=http://127.0.0.1:48218
# Set the exact Editor used by this LAB, not the legacy Editor hostname.
VITE_TASKNOTES_EDITOR_ORIGIN=https://lab.mdbase-editor-lab.pages.dev
# LAB trust/WASM inputs are independently authenticated release artifacts,
# never an origin-selected runtime fallback or a production default.
# Google Calendar is LAB-only: set the Calendar LAB Worker to enable it. Unset, it is absent.
# Its session cookie is same-site only, so run through the dev server's proxy on http://localhost:4173.
# TASKNOTES_CALENDAR_PROXY=https://tasknotes-calendar-lab.callumalpass.workers.dev
# VITE_TASKNOTES_CALENDAR_ORIGIN=http://localhost:4173/calendar-service
